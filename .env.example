# Copiá este archivo a .env y ajustá los valores
PORT=3000
# Cambiá esto por un texto largo y aleatorio (firma las sesiones)
SESSION_SECRET=cambiame-por-un-texto-largo-y-aleatorio

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=negocio_db
# Zona horaria del negocio (afecta las fechas de ventas y cierres)
DB_TIMEZONE=-03:00
