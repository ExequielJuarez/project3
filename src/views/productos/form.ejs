<%- include('../partials/inicio') %>
<div class="pagina-cab"><div><h1><%= esNuevo ? 'Nuevo producto' : 'Editar producto' %></h1></div>
  <a class="btn" href="/productos">Volver a productos</a></div>
<% if (error) { %><div class="aviso aviso-error"><svg class="ico"><use href="#i-alerta"/></svg><span><%= error %></span></div><% } %>

<div class="<%= esNuevo ? '' : 'rejilla-2' %>">
<form class="tarjeta" method="post" action="<%= esNuevo ? '/productos' : '/productos/' + p.id + '?_method=PUT' %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="tarjeta-cuerpo">
    <div class="form-grid">
      <div class="campo"><label for="nombre">Nombre *</label><input id="nombre" name="nombre" type="text" value="<%= p.nombre || '' %>" required maxlength="150" <%= esNuevo ? 'autofocus' : '' %>></div>
      <div class="campo c-6"><label for="codigo_barras">Código de barras</label>
        <input id="codigo_barras" name="codigo_barras" type="text" class="mono" value="<%= p.codigo_barras || '' %>" autocomplete="off" data-sin-enter>
        <small>Hacé clic acá y pasá la pistola por el producto.</small></div>
      <div class="campo c-6"><label for="codigo_interno">Código interno / manual</label>
        <input id="codigo_interno" name="codigo_interno" type="text" class="mono" value="<%= p.codigo_interno || '' %>" autocomplete="off" data-sin-enter>
        <small>Opcional: un código corto para tipear (ej. 101).</small></div>
      <div class="campo c-6"><label for="categoria_id">Categoría</label>
        <select id="categoria_id" name="categoria_id"><option value="">Sin categoría</option>
          <% categorias.forEach(c => { %><option value="<%= c.id %>" <%= String(p.categoria_id) === String(c.id) ? 'selected' : '' %>><%= c.nombre %></option><% }) %></select></div>
      <div class="campo c-6"><label for="unidad">Unidad</label>
        <select id="unidad" name="unidad"><% ['u', 'kg', 'g', 'lt', 'ml', 'm', 'caja', 'pack'].forEach(u => { %><option <%= (p.unidad || 'u') === u ? 'selected' : '' %>><%= u %></option><% }) %></select></div>
      <div class="campo c-4"><label for="costo">Costo</label><div class="prefijo"><span>$</span><input id="costo" name="costo" type="text" inputmode="decimal" value="<%= p.costo ?? 0 %>"></div></div>
      <div class="campo c-4"><label for="precio">Precio de venta *</label><div class="prefijo"><span>$</span><input id="precio" name="precio" type="text" inputmode="decimal" value="<%= p.precio ?? '' %>" required></div></div>
      <div class="campo c-4"><label>Margen</label><div class="negrita" id="margen" style="min-height:44px;display:flex;align-items:center">—</div></div>
      <% if (esNuevo) { %>
      <div class="campo c-6"><label for="stock">Stock inicial</label><input id="stock" name="stock" type="text" inputmode="decimal" value="<%= p.stock ?? 0 %>"></div>
      <% } %>
      <div class="campo c-6"><label for="stock_minimo">Stock mínimo (alerta)</label><input id="stock_minimo" name="stock_minimo" type="text" inputmode="decimal" value="<%= p.stock_minimo ?? 0 %>"></div>
      <div class="campo"><label class="check"><input type="checkbox" name="activo" value="1" <%= p.activo ? 'checked' : '' %>>Producto activo (se puede vender)</label></div>
    </div>
    <div class="form-pie">
      <% if (esNuevo) { %><button class="btn" name="otro" value="1">Guardar y crear otro</button><% } %>
      <button class="btn btn-primario">Guardar producto</button>
    </div>
  </div>
</form>

<% if (!esNuevo) { %>
<div class="pila">
  <form class="tarjeta" method="post" action="/productos/<%= p.id %>/ajuste">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="tarjeta-cab"><h2>Stock actual: <span class="num"><%= cant(p.stock) %> <%= p.unidad %></span></h2></div>
    <div class="tarjeta-cuerpo form-grid">
      <div class="campo"><label for="aj-stock">Stock real contado</label><input id="aj-stock" name="stock" type="text" inputmode="decimal" required></div>
      <div class="campo"><label for="aj-nota">Motivo</label><input id="aj-nota" name="nota" type="text" placeholder="Inventario, rotura, vencimiento…"></div>
      <div class="campo"><button class="btn btn-primario">Ajustar stock</button></div>
    </div>
  </form>
  <section class="tarjeta">
    <div class="tarjeta-cab"><h2>Movimientos de stock</h2></div>
    <% if (!movimientos.length) { %><p class="vacio">Sin movimientos.</p><% } else { %>
    <div class="tabla-caja"><table class="tabla tabla-responsive">
      <thead><tr><th>Fecha</th><th>Tipo</th><th class="derecha">Cant.</th><th class="derecha">Queda</th><th>Ref.</th></tr></thead>
      <tbody><% movimientos.forEach(m => { %>
        <tr><td data-etiqueta="Fecha"><%= fechaHora(m.creado_en) %></td><td data-etiqueta="Tipo"><%= m.tipo %></td>
          <td data-etiqueta="Cant." class="derecha num <%= m.cantidad > 0 ? 'mov-pos' : 'mov-neg' %>"><%= m.cantidad > 0 ? '+' : '' %><%= cant(m.cantidad) %></td>
          <td data-etiqueta="Queda" class="derecha num"><%= cant(m.stock_resultante) %></td><td data-etiqueta="Ref." class="mono"><%= m.referencia || m.nota || '' %></td></tr>
      <% }) %></tbody></table></div><% } %>
  </section>
  <form method="post" action="/productos/<%= p.id %>?_method=DELETE" data-confirmar="¿Desactivar este producto? Dejará de aparecer en el punto de venta pero se conserva su historial.">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-peligro btn-chico"><svg class="ico"><use href="#i-papelera"/></svg>Desactivar producto</button>
  </form>
</div>
<% } %>
</div>
<%- include('../partials/fin', { script: 'producto' }) %>
